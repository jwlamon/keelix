{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_TOKEN": "keychain:login/github-mcp-token"
      }
    },
    "postgres": {
      "type": "http",
      "url": "http://127.0.0.1:5555/mcp",
      "headers": {
        "Authorization": "Bearer local-dev-token"
      }
    }
  }
}
