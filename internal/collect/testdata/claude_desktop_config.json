{
  "mcpServers": {
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search@0.6.2"],
      "env": {
        "BRAVE_API_KEY": "REPLACE_WITH_YOUR_KEY_HERE"
      }
    }
  },
  "preferences": {
    "bypassPermissionsModeEnabled": false,
    "allowAllBrowserActions": false,
    "localAgentModeTrustedFolders": [
      "/Users/testuser/projects"
    ]
  }
}
